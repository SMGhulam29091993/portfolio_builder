{
  "name": "@portfolio/sections",
  "version": "0.0.0",
  "private": true,
  "description": "Section renderers, layout variant registry and page composer, used by the public site and the CMS preview.",
  "type": "module",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "devDependencies": {
    "@portfolio/eslint-config": "workspace:*",
    "@portfolio/tsconfig": "workspace:*",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "10.12.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  },
  "peerDependencies": {
    "react": "19.3.1"
  },
  "dependencies": {
    "@portfolio/contracts": "workspace:*",
    "@portfolio/design-tokens": "workspace:*"
  }
}
