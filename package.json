{
  "name": "portfolio-builder",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.1.2",
  "engines": {
    "node": ">=24.12.0"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:e2e": "turbo run test:e2e",
    "drift": "turbo run drift",
    "seed:owner": "pnpm --filter @portfolio/api seed:owner",
    "seed:all": "pnpm --filter @portfolio/api seed:all"
  },
  "devDependencies": {
    "turbo": "2.11.8"
  }
}
