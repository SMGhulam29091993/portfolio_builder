{
  "name": "@portfolio/api",
  "version": "0.0.0",
  "private": true,
  "description": "Express + Mongoose API for the Portfolio Builder CMS and the published site.",
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx watch --env-file-if-exists=.env src/main.ts",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "mongoose": "9.11.2",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@portfolio/eslint-config": "workspace:*",
    "@portfolio/tsconfig": "workspace:*",
    "@types/node": "24.19.2",
    "eslint": "10.12.0",
    "mongodb-memory-server": "11.3.0",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
