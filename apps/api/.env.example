# Environment for `apps/api` — copy to `apps/api/.env` (git-ignored). The `dev` and `start`
# scripts load that file with `--env-file-if-exists`; `src/config/env.ts` validates it at startup
# and names any variable that is missing or malformed (`monorepo-foundation.AC2`).
#
# Every API variable in `.ai-context/architecture.md` → Environment is listed here, and
# `src/config/env-example.spec.ts` fails if the two drift apart. Uncommented lines are the ones
# the API reads today, with values that work against `docker-compose.dev.yml`. Commented lines
# are read by a later spec, named above each; uncomment them when that spec lands. Secrets are
# left blank on purpose: never commit a real value to this file.

# --- Runtime -------------------------------------------------------------------------------
NODE_ENV=development
# 4000 keeps the API off 3000, which the web dev server pins (`apps/web/package.json`).
PORT=4000

# --- Datastore -----------------------------------------------------------------------------
# The MongoDB from `docker-compose.dev.yml`. 127.0.0.1 rather than localhost: the container
# publishes on IPv4 loopback only, and Node may resolve localhost to ::1 first.
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio_builder
# The Redis from `docker-compose.dev.yml`: the `auth` session and one-time-code reference store
# (ADR-0008). Database 0 is for development; the test harnesses use 1-15.
REDIS_URL=redis://127.0.0.1:6379/0

# --- Auth (owner-auth) ---------------------------------------------------------------------
# The web app's origin: the only `Origin` allowed to send a non-GET to `/api/v1/auth` and
# `/api/v1/cms`. Exactly as the browser sends it — scheme, host, port; no path or trailing slash.
# The web dev server (`apps/web/package.json`); use the same host spelling you open it with.
WEB_ORIGIN=http://localhost:3000
# Signs the access token; at least 32 characters. The value below is a development placeholder
# so a straight copy starts: replace it locally with `openssl rand -base64 48`, and never use it
# in production.
JWT_ACCESS_SECRET=development-only-placeholder-replace-me-000000
# Read by the development-only seeder (`pnpm seed:owner`, owner-auth.T09) to create one local
# account; it refuses to run in production (ADR-0010). Real accounts come from registration.
# Blank, the API still starts and only the seeder refuses. The password needs 12 to 200
# characters; the display name is a fixed `Owner`, changed later in the CMS.
OWNER_EMAIL=
OWNER_PASSWORD=
# The owner secret key (account-registration, ADR-0010): registering with exactly this value
# while no owner exists claims the platform owner account; after that it is refused for good.
# Blank keeps the claim closed. 32 to 200 characters; generate one with `openssl rand -base64 48`.
OWNER_REGISTRATION_SECRET=
# Gmail mail strategy for password-reset and verification codes (ADR-0009). Use a Gmail app password, never the
# account password. Left blank, the API runs without mail and password reset answers 503; in
# production it refuses to start until both are set.
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Sender address; defaults to GMAIL_USER when blank.
MAIL_FROM=

# --- Public site (public-site-rendering) ---------------------------------------------------
# Which portfolio `/api/v1/public` serves.
# DEFAULT_PORTFOLIO_SLUG=

# --- AI design generation (ai-design-studio) ----------------------------------------------
# `gemini` | `openrouter` | `ollama`. Left unset outside production, the stub generator answers
# from a fixture (`constitution.md` → Dev-bypass guard); production refuses to start without it.
# AI_PROVIDER=
# Model ID for the chosen provider — configuration, never a code literal.
# AI_MODEL=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# AI_TIMEOUT_MS=
# AI_DAILY_PROPOSAL_LIMIT=

# --- Publish → site revalidation (publish-pipeline) ----------------------------------------
# The web app's revalidation endpoint, and the secret both apps share for it.
# WEB_REVALIDATE_URL=
# REVALIDATE_SECRET=
